{
  "id": "retiring-the-guard",
  "level": 5,
  "title": "Retiring the Guard",
  "brief": "The treasury is moving to a new setup, and one day the Policy Guard must come off. All three owners will sign for that, and they want to turn off the guard completely, for owners and for modules, in one batch. The new rules are for that and nothing else. The Allowance Module is still enabled and must never turn off the guard, alone or in a batch.",
  "setup": {
    "modules": [
      "AllowanceModule"
    ],
    "balances": {
      "ETH": "5"
    },
    "rules": []
  },
  "allowedPolicies": [
    "AllowPolicy",
    "IncreasedThresholdPolicy",
    "MultiSendPolicy",
    "AllowedModulePolicy"
  ],
  "parRules": 3,
  "tests": [
    {
      "label": "Turn off the guard completely in one batch, all owners sign",
      "tx": {
        "to": "MultiSend",
        "operation": "DELEGATECALL",
        "call": {
          "fn": "multiSend",
          "batch": [
            {
              "to": "Safe",
              "call": {
                "fn": "setGuard",
                "args": [
                  "Zero"
                ]
              },
              "context": {
                "type": "ownerSignatures",
                "signers": [
                  "Alice",
                  "Bob",
                  "Carol"
                ]
              }
            },
            {
              "to": "Safe",
              "call": {
                "fn": "setModuleGuard",
                "args": [
                  "Zero"
                ]
              },
              "context": {
                "type": "ownerSignatures",
                "signers": [
                  "Alice",
                  "Bob",
                  "Carol"
                ]
              }
            }
          ]
        }
      },
      "want": "pass"
    },
    {
      "label": "Turn off the guard, all owners sign",
      "tx": {
        "to": "Safe",
        "call": {
          "fn": "setGuard",
          "args": [
            "Zero"
          ]
        },
        "context": {
          "type": "ownerSignatures",
          "signers": [
            "Alice",
            "Bob",
            "Carol"
          ]
        }
      },
      "want": "pass"
    },
    {
      "label": "Turn off the guard, only two owners sign",
      "tx": {
        "to": "Safe",
        "call": {
          "fn": "setGuard",
          "args": [
            "Zero"
          ]
        },
        "context": {
          "type": "ownerSignatures",
          "signers": [
            "Alice",
            "Bob"
          ]
        }
      },
      "want": "block"
    },
    {
      "label": "The Allowance Module turns off the guard",
      "tx": {
        "path": "module",
        "module": "AllowanceModule",
        "to": "Safe",
        "call": {
          "fn": "setGuard",
          "args": [
            "Zero"
          ]
        }
      },
      "want": "block"
    },
    {
      "label": "The Allowance Module turns off the guard for modules",
      "tx": {
        "path": "module",
        "module": "AllowanceModule",
        "to": "Safe",
        "call": {
          "fn": "setModuleGuard",
          "args": [
            "Zero"
          ]
        }
      },
      "want": "block"
    },
    {
      "label": "The Allowance Module turns off the guard completely in one batch",
      "tx": {
        "path": "module",
        "module": "AllowanceModule",
        "to": "MultiSend",
        "operation": "DELEGATECALL",
        "call": {
          "fn": "multiSend",
          "batch": [
            {
              "to": "Safe",
              "call": {
                "fn": "setGuard",
                "args": [
                  "Zero"
                ]
              }
            },
            {
              "to": "Safe",
              "call": {
                "fn": "setModuleGuard",
                "args": [
                  "Zero"
                ]
              }
            }
          ]
        }
      },
      "want": "block"
    },
    {
      "label": "Send 1 ETH to Mallory, all owners sign",
      "tx": {
        "to": "Mallory",
        "value": "1",
        "context": {
          "type": "ownerSignatures",
          "signers": [
            "Alice",
            "Bob",
            "Carol"
          ]
        }
      },
      "want": "block"
    },
    {
      "label": "Switch on the Recovery Module, all owners sign",
      "tx": {
        "to": "Safe",
        "call": {
          "fn": "enableModule",
          "args": [
            "RecoveryModule"
          ]
        },
        "context": {
          "type": "ownerSignatures",
          "signers": [
            "Alice",
            "Bob",
            "Carol"
          ]
        }
      },
      "want": "block"
    }
  ],
  "hints": [
    "Always Allow on turning off the guard, or on the batch, lets the enabled module do it too. You need a policy that only owners can satisfy.",
    "More Owners Sign asks for more owners than usual, and it refuses every module transaction.",
    "More Owners Sign on the Safe's two guard actions, \"Change the guard\" and \"Change the guard for modules\", plus the Batch Checker so both fit in one batch."
  ],
  "solution": [
    {
      "target": "MultiSend",
      "selector": "multiSend",
      "operation": "DELEGATECALL",
      "policy": "MultiSendPolicy"
    },
    {
      "target": "Safe",
      "selector": "setGuard",
      "policy": "IncreasedThresholdPolicy",
      "config": {
        "maxAbsent": 0
      }
    },
    {
      "target": "Safe",
      "selector": "setModuleGuard",
      "policy": "IncreasedThresholdPolicy",
      "config": {
        "maxAbsent": 0
      }
    }
  ],
  "explain": "A module cannot sign, so a policy built on owners signing refuses it outright. That makes More Owners Sign an owner-only lock: every owner must sign to turn off the guard, and no module ever can. The batch needs the Batch Checker, so each step still meets that lock. Always Allow on the batch would let the module turn off the guard in one go. In a live Safe these rules arrive through the waiting period, and turning off the guard follows in a later transaction."
}

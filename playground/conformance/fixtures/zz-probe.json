{
  "id": "zz-probe",
  "chapter": "probe", "order": 0, "title": "Probe", "summary": "", "lesson": "",
  "setup": { "balances": { "ETH": "5", "USDC": "100", "WETH": "1" }, "modules": ["AllowanceModule"], "guards": { "transaction": false, "module": false } },
  "steps": [
    { "do": "tx", "label": "SPEC: setGuard(Mallory) -> GS300", "tx": { "to": "Safe", "call": { "fn": "setGuard", "args": ["Mallory"] } }, "expect": { "ok": false, "by": "execution", "error": "GS300" } },
    { "do": "tx", "label": "SPEC: setGuard(USDC) -> GS300", "tx": { "to": "Safe", "call": { "fn": "setGuard", "args": ["USDC"] } }, "expect": { "ok": false, "by": "execution", "error": "GS300" } },
    { "do": "tx", "label": "SPEC: setGuard(AllowPolicy) -> GS300", "tx": { "to": "Safe", "call": { "fn": "setGuard", "args": ["AllowPolicy"] } }, "expect": { "ok": false, "by": "execution", "error": "GS300" } },
    { "do": "tx", "label": "SPEC: setGuard(Safe) -> GS300", "tx": { "to": "Safe", "call": { "fn": "setGuard", "args": ["Safe"] } }, "expect": { "ok": false, "by": "execution", "error": "GS300" } },
    { "do": "tx", "label": "SPEC: setModuleGuard(Mallory) -> GS301", "tx": { "to": "Safe", "call": { "fn": "setModuleGuard", "args": ["Mallory"] } }, "expect": { "ok": false, "by": "execution", "error": "GS301" } },
    { "do": "tx", "label": "SPEC: ETH self-transfer with unknown calldata succeeds", "tx": { "to": "Safe", "value": "1", "data": "0x12345678" }, "expect": { "ok": true } },
    { "do": "tx", "label": "SPEC: unknown calldata to Safe succeeds", "tx": { "to": "Safe", "data": "0x12345678" }, "expect": { "ok": true } },
    { "do": "tx", "label": "SPEC: plain ETH self-transfer succeeds", "tx": { "to": "Safe", "value": "1" }, "expect": { "ok": true } },
    { "do": "tx", "label": "SPEC: ETH to token reverts", "tx": { "to": "USDC", "value": "1" }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "SPEC: unknown selector to token reverts", "tx": { "to": "USDC", "data": "0x12345678" }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "SPEC: insufficient ETH -> Reverted", "tx": { "to": "Dave", "value": "100" }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "MultiSend as CALL with value sub-tx", "tx": { "to": "MultiSend", "call": { "fn": "multiSend", "batch": [{ "to": "Dave", "value": "0.1" }] } }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "MultiSend as CALL with zero-value sub-tx", "tx": { "to": "MultiSend", "call": { "fn": "multiSend", "batch": [{ "to": "Dave" }] } }, "expect": { "ok": true } },
    { "do": "tx", "label": "MultiSend as CALL with ETH attached", "tx": { "to": "MultiSend", "value": "0.1", "call": { "fn": "multiSend", "batch": [{ "to": "Dave", "value": "0.1" }] } }, "expect": { "ok": true }, "expectState": { "balances": { "Dave": { "ETH": "0.1" } } } },
    { "do": "tx", "label": "MultiSend sub-tx delegatecall reverts", "tx": { "to": "MultiSend", "operation": "DELEGATECALL", "call": { "fn": "multiSend", "batch": [{ "to": "MysteryContract", "operation": "DELEGATECALL" }] } }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "MultiSend sub-tx to 0x0 is the Safe", "tx": { "to": "MultiSend", "operation": "DELEGATECALL", "call": { "fn": "multiSend", "batch": [{ "to": "0x0000000000000000000000000000000000000000", "call": { "fn": "changeThreshold", "args": [3] } }] } }, "expect": { "ok": true }, "expectState": { "threshold": 3 } },
    { "do": "tx", "label": "Back to 2 of 3", "tx": { "to": "Safe", "call": { "fn": "changeThreshold", "args": [2] } }, "expect": { "ok": true } },
    { "do": "tx", "label": "Delegatecall to MysteryContract", "tx": { "to": "MysteryContract", "operation": "DELEGATECALL", "data": "0xdeadbeef" }, "expect": { "ok": true } },
    { "do": "tx", "label": "WETH fallback deposit", "tx": { "to": "WETH", "value": "1", "data": "0xdeadbeef" }, "expect": { "ok": true }, "expectState": { "balances": { "Safe": { "WETH": "2" } } } },
    { "do": "tx", "label": "WETH withdraw", "tx": { "to": "WETH", "call": { "fn": "withdraw", "args": ["1.5"] } }, "expect": { "ok": true }, "expectState": { "balances": { "Safe": { "WETH": "0.5" } } } },
    { "do": "tx", "label": "WETH withdraw too much", "tx": { "to": "WETH", "call": { "fn": "withdraw", "args": ["1"] } }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "WETH transfer too much", "tx": { "to": "WETH", "call": { "fn": "transfer", "args": ["Dave", "1"] } }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "Add Dave as owner, threshold 2", "tx": { "to": "Safe", "call": { "fn": "addOwnerWithThreshold", "args": ["Dave", 2] } }, "expect": { "ok": true }, "expectState": { "owners": ["Alice", "Bob", "Carol", "Dave"] } },
    { "do": "tx", "label": "Remove Bob, threshold 2", "tx": { "to": "Safe", "call": { "fn": "removeOwner", "args": ["Bob", 2] } }, "expect": { "ok": true }, "expectState": { "owners": ["Alice", "Carol", "Dave"] } },
    { "do": "tx", "label": "Remove Mallory (not an owner)", "tx": { "to": "Safe", "call": { "fn": "removeOwner", "args": ["Mallory", 2] } }, "expect": { "ok": false, "by": "execution", "error": "GS205" } },
    { "do": "tx", "label": "changeThreshold 5", "tx": { "to": "Safe", "call": { "fn": "changeThreshold", "args": [5] } }, "expect": { "ok": false, "by": "execution", "error": "GS201" } },
    { "do": "tx", "label": "Enable RecoveryModule", "tx": { "to": "Safe", "call": { "fn": "enableModule", "args": ["RecoveryModule"] } }, "expect": { "ok": true }, "expectState": { "modules": ["AllowanceModule", "RecoveryModule"] } },
    { "do": "tx", "label": "Disable AllowanceModule", "tx": { "to": "Safe", "call": { "fn": "disableModule", "args": ["AllowanceModule"] } }, "expect": { "ok": true }, "expectState": { "modules": ["RecoveryModule"] } },
    { "do": "tx", "label": "Disable AllowanceModule again", "tx": { "to": "Safe", "call": { "fn": "disableModule", "args": ["AllowanceModule"] } }, "expect": { "ok": false, "by": "execution", "error": "GS103" } },
    { "do": "tx", "label": "No guard: configureImmediately with a bad rule", "tx": { "to": "PolicyGuard", "call": { "fn": "configureImmediately", "configurations": [{ "target": "USDC", "selector": "transfer", "policy": "NativeTransferPolicy" }] } }, "expect": { "ok": false, "by": "execution", "error": "PolicyConfigurationFailed" } },
    { "do": "tx", "label": "No guard: configureImmediately ERC20Transfer on approve", "tx": { "to": "PolicyGuard", "call": { "fn": "configureImmediately", "configurations": [{ "target": "USDC", "selector": "approve", "policy": "ERC20TransferPolicy" }] } }, "expect": { "ok": false, "by": "execution", "error": "InvalidSelector" } },
    { "do": "tx", "label": "No guard: the guard's own checkTransaction", "tx": { "to": "PolicyGuard", "data": "0x12345678" }, "expect": { "ok": false, "by": "execution", "error": "Reverted" } },
    { "do": "tx", "label": "No guard: safeTxGas with failing call", "tx": { "to": "USDC", "safeTxGas": "100000", "call": { "fn": "transfer", "args": ["Dave", "1000"] } }, "expect": { "ok": false, "by": "execution", "error": "CallFailed" }, "expectState": { "nonce": 13 } }
  ]
}

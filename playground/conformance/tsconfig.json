{
  "//": "Type checking only (npx tsc -p conformance). Hardhat's ts-node loads these files with the policy-engine's root tsconfig (CommonJS, transpile-only).",
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "typeRoots": ["../node_modules/@types", "../../node_modules/@types"]
  },
  "include": ["*.ts"]
}

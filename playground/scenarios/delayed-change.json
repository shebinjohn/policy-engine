{
  "id": "delayed-change",
  "chapter": "changing-the-rules",
  "order": 19,
  "title": "The Waiting Period",
  "summary": "A new rule is requested, refused while it waits, and applied after an hour.",
  "lesson": "After hardening, every rule change is requested first and applied after the waiting period, one hour here. The wait gives the owners time to spot and cancel a change they did not expect.",
  "readme": "setup-with-safe",
  "setup": {
    "rules": []
  },
  "steps": [
    {
      "do": "tx",
      "label": "Ask for a rule that allows adding modules",
      "tx": {
        "to": "PolicyGuard",
        "call": {
          "fn": "requestConfiguration",
          "configurations": [
            {
              "target": "Safe",
              "selector": "enableModule",
              "policy": "AllowPolicy",
              "note": "Owners may add modules"
            }
          ]
        }
      },
      "expect": {
        "ok": true
      },
      "note": "Asking for a change needs no rule. It is always allowed."
    },
    {
      "do": "tx",
      "label": "Apply it right away",
      "tx": {
        "to": "PolicyGuard",
        "call": {
          "fn": "applyConfiguration",
          "configurations": [
            {
              "target": "Safe",
              "selector": "enableModule",
              "policy": "AllowPolicy",
              "note": "Owners may add modules"
            }
          ]
        }
      },
      "expect": {
        "ok": false,
        "by": "execution",
        "error": "RootConfigurationPending"
      },
      "note": "The request is recorded, but the hour has not passed."
    },
    {
      "do": "wait",
      "label": "Wait one hour",
      "seconds": 3600
    },
    {
      "do": "tx",
      "label": "Apply the rule",
      "tx": {
        "to": "PolicyGuard",
        "call": {
          "fn": "applyConfiguration",
          "configurations": [
            {
              "target": "Safe",
              "selector": "enableModule",
              "policy": "AllowPolicy",
              "note": "Owners may add modules"
            }
          ]
        }
      },
      "expect": {
        "ok": true
      }
    },
    {
      "do": "tx",
      "label": "Add the Recovery Module",
      "tx": {
        "to": "Safe",
        "call": {
          "fn": "enableModule",
          "args": [
            "RecoveryModule"
          ]
        }
      },
      "expect": {
        "ok": true
      },
      "note": "The new rule covers it.",
      "expectState": {
        "modules": [
          "RecoveryModule"
        ]
      }
    }
  ]
}

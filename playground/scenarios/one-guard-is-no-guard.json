{
  "id": "one-guard-is-no-guard",
  "chapter": "modules-and-guards",
  "order": 18,
  "title": "Half a Guard",
  "summary": "The transaction guard goes in first and the module guard is then refused. Meanwhile a module ignores every rule and removes the guard.",
  "lesson": "Install both guards in one batch, or the module guard first. Once the transaction guard is in, adding the module guard is a checked call that needs a rule. Until it is in, any enabled module skips every rule, and can even switch the guard off without a wait.",
  "readme": "setup-with-safe",
  "setup": {
    "modules": [
      "AllowanceModule"
    ],
    "guards": {
      "transaction": false,
      "module": false
    },
    "balances": {
      "USDC": "10000"
    },
    "rules": [
      {
        "target": "USDC",
        "selector": "transfer",
        "policy": "ERC20TransferPolicy",
        "config": {
          "recipients": [
            {
              "account": "Dave",
              "permission": "ALWAYS"
            }
          ]
        },
        "note": "USDC goes to Dave only"
      }
    ]
  },
  "steps": [
    {
      "do": "tx",
      "label": "Install the transaction guard",
      "tx": {
        "to": "Safe",
        "call": {
          "fn": "setGuard",
          "args": [
            "PolicyGuard"
          ]
        }
      },
      "expect": {
        "ok": true
      },
      "note": "No guard is installed yet, so this runs unchecked.",
      "expectState": {
        "txGuard": "PolicyGuard",
        "moduleGuard": null
      }
    },
    {
      "do": "tx",
      "label": "Install the module guard",
      "tx": {
        "to": "Safe",
        "call": {
          "fn": "setModuleGuard",
          "args": [
            "PolicyGuard"
          ]
        }
      },
      "expect": {
        "ok": false,
        "by": "guard",
        "error": "AccessDenied",
        "policy": null
      },
      "note": "The transaction guard now checks every owner transaction, this one included, and no rule allows setting the module guard. Fixing that is a rule change, with the waiting period."
    },
    {
      "do": "tx",
      "label": "The owners pay Mallory 4000 USDC",
      "tx": {
        "to": "USDC",
        "call": {
          "fn": "transfer",
          "args": [
            "Mallory",
            "4000"
          ]
        }
      },
      "expect": {
        "ok": false,
        "by": "guard",
        "error": "PolicyReverted",
        "policy": "ERC20TransferPolicy",
        "reason": {
          "error": "Unauthorized"
        }
      },
      "note": "Owner transactions are checked."
    },
    {
      "do": "tx",
      "label": "The Allowance Module pays Mallory 4000 USDC",
      "tx": {
        "path": "module",
        "module": "AllowanceModule",
        "to": "USDC",
        "call": {
          "fn": "transfer",
          "args": [
            "Mallory",
            "4000"
          ]
        }
      },
      "expect": {
        "ok": true
      },
      "note": "Module transactions are not: there is no module guard, so they skip every rule.",
      "expectState": {
        "balances": {
          "Mallory": {
            "USDC": "4000"
          }
        }
      }
    },
    {
      "do": "tx",
      "label": "The Allowance Module removes the guard",
      "tx": {
        "path": "module",
        "module": "AllowanceModule",
        "to": "Safe",
        "call": {
          "fn": "setGuard",
          "args": [
            "Zero"
          ]
        }
      },
      "expect": {
        "ok": true
      },
      "note": "No rule, no waiting period. The module simply switches the guard off, and now nothing checks the owners either.",
      "expectState": {
        "txGuard": null,
        "moduleGuard": null
      }
    }
  ]
}
